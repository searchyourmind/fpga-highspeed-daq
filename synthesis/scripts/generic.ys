read_verilog -sv -DSYNTHESIS rtl/counter.sv rtl/daq_top.sv rtl/dma_descriptor.sv rtl/dma_reader.sv rtl/dma_writer.sv rtl/sensor_source.sv rtl/stream_fifo.sv rtl/stream_processor.sv rtl/stream_to_mem.sv rtl/streaming_top.sv rtl/tlp_packetizer.sv
