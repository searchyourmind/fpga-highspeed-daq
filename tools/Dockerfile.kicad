FROM ubuntu:26.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
 kicad kicad-symbols kicad-footprints kicad-packages3d python3 python3-pil python3-numpy \
 python3-matplotlib python3-reportlab python3-pytest xvfb xauth fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
ENV MPLBACKEND=Agg
WORKDIR /work
